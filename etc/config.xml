<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <commercekings_notification>
            <general>
                <provider_email>magento_email</provider_email>
                <cooldown_days>7</cooldown_days>
                <one_click_unsubscribe>0</one_click_unsubscribe>
            </general>
            <quiet_hours>
                <enabled>0</enabled>
                <from>21,00,00</from>
                <to>08,00,00</to>
            </quiet_hours>
            <do_not_contact>
                <link>1</link>
                <lift_days>90</lift_days>
            </do_not_contact>
            <address_consent>
                <wording_sms>Yes, text me offers and reminders at this number. Message frequency varies; message and data rates may apply. Reply STOP to stop.</wording_sms>
                <wording_whatsapp>Yes, send me offers and reminders on WhatsApp at this number. I can stop them at any time.</wording_whatsapp>
                <keep_withdrawn_days>1825</keep_withdrawn_days>
            </address_consent>
        </commercekings_notification>
    </default>
</config>
