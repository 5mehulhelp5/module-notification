<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- the email cooldown: keyed hashes only, never an address -->
    <table name="ck_notification_cooldown" resource="default" engine="innodb" comment="CK notification: temporary recipient cooldown">
        <column xsi:type="varchar" name="recipient_hash" nullable="false" length="64" comment="Keyed hash of normalized recipient"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="Claim time"/>
        <column xsi:type="varchar" name="claim_token" nullable="true" length="32" comment="Owner of delivery claim"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="recipient_hash"/>
        </constraint>
        <index referenceId="CK_NOTIFICATION_COOLDOWN_SENT_AT" indexType="btree">
            <column name="sent_at"/>
        </index>
    </table>
    <!-- guest email addresses, one row per website and address; features point to contact_id -->
    <table name="ck_notification_contact" resource="default" engine="innodb" comment="CK notification: guest contacts">
        <column xsi:type="int" name="contact_id" unsigned="true" nullable="false" identity="true" comment="Contact ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Email address"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="First seen"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="contact_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CK_NOTIFICATION_CONTACT_WEBSITE_ID_EMAIL">
            <column name="website_id"/>
            <column name="email"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CK_NOTIFICATION_CONTACT_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID"
                    table="ck_notification_contact" column="website_id" referenceTable="store_website"
                    referenceColumn="website_id" onDelete="CASCADE"/>
        <index referenceId="CK_NOTIFICATION_CONTACT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
