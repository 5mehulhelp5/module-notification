<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- the email cooldown: keyed hashes only, never an address -->
    <table name="ck_notification_cooldown" resource="default" engine="innodb" comment="CK notification: temporary recipient cooldown">
        <column xsi:type="varchar" name="recipient_hash" nullable="false" length="64" comment="Keyed hash of normalized recipient"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="Claim time"/>
        <column xsi:type="varchar" name="claim_token" nullable="true" length="32" comment="Owner of delivery claim"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="recipient_hash"/>
        </constraint>
        <index referenceId="CK_NOTIFICATION_COOLDOWN_SENT_AT" indexType="btree">
            <column name="sent_at"/>
        </index>
    </table>
    <!-- do not contact: recipients who stopped marketing notifications; keyed hashes only, never an address -->
    <table name="ck_notification_recipient_block" resource="default" engine="innodb" comment="CK notification: do not contact">
        <column xsi:type="varchar" name="recipient_hash" nullable="false" length="64" comment="Keyed hash of channel and normalized recipient"/>
        <column xsi:type="timestamp" name="blocked_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="Blocked at"/>
        <column xsi:type="timestamp" name="last_attempt_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="Last sign-up attempt (restarts the lift timer)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="recipient_hash"/>
        </constraint>
        <index referenceId="CK_NOTIFICATION_RECIPIENT_BLOCK_LAST_ATTEMPT_AT" indexType="btree">
            <column name="last_attempt_at"/>
        </index>
    </table>
    <!-- guest email addresses, one row per website and address; features point to contact_id -->
    <table name="ck_notification_contact" resource="default" engine="innodb" comment="CK notification: guest contacts">
        <column xsi:type="int" name="contact_id" unsigned="true" nullable="false" identity="true" comment="Contact ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Email address, as first entered"/>
        <!-- the identity (ContactRepository::key()): the email column's collation ignores case and accents -->
        <column xsi:type="varchar" name="email_key" nullable="false" length="64" comment="sha256 of the normalized address"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="First seen"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="contact_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CK_NOTIFICATION_CONTACT_WEBSITE_ID_EMAIL_KEY">
            <column name="website_id"/>
            <column name="email_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CK_NOTIFICATION_CONTACT_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID"
                    table="ck_notification_contact" column="website_id" referenceTable="store_website"
                    referenceColumn="website_id" onDelete="CASCADE"/>
        <index referenceId="CK_NOTIFICATION_CONTACT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
    <!-- who wants which notification, under which permission; no row = not subscribed -->
    <table name="ck_notification_subscription" resource="default" engine="innodb" comment="CK notification: subscriptions">
        <column xsi:type="int" name="subscription_id" unsigned="true" nullable="false" identity="true" comment="Subscription ID"/>
        <column xsi:type="varchar" name="type" nullable="false" length="64" comment="Notification type code"/>
        <column xsi:type="int" name="reference_id" unsigned="true" nullable="false" comment="The type's own id (quote, product, ...)"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store to send from"/>
        <column xsi:type="varchar" name="subject_key" nullable="false" length="32" default="" comment="'' for single types, else c:contact or u:customer"/>
        <column xsi:type="int" name="contact_id" unsigned="true" nullable="true" comment="Guest contact"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer"/>
        <column xsi:type="varchar" name="permission_ref" nullable="false" length="64" default=""
                comment="Permission reference (SubscriptionPermissionInterface), '' when none"/>
        <column xsi:type="timestamp" name="captured_at" nullable="false" on_update="false" default="CURRENT_TIMESTAMP" comment="Created or last changed"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="subscription_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CK_NOTIFICATION_SUBSCRIPTION_TYPE_REFERENCE_ID_SUBJECT_KEY">
            <column name="type"/>
            <column name="reference_id"/>
            <column name="subject_key"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="CK_NOTIFICATION_SUBSCRIPTION_STORE_ID_STORE_STORE_ID"
                    table="ck_notification_subscription" column="store_id" referenceTable="store"
                    referenceColumn="store_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="CK_NOTIFICATION_SUBSCRIPTION_CONTACT_ID_CK_NOTIFICATION_CONTACT_CONTACT_ID"
                    table="ck_notification_subscription" column="contact_id" referenceTable="ck_notification_contact"
                    referenceColumn="contact_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="CK_NOTIFICATION_SUBSCRIPTION_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="ck_notification_subscription" column="customer_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="CK_NOTIFICATION_SUBSCRIPTION_PERMISSION_REF" indexType="btree">
            <column name="permission_ref"/>
        </index>
        <index referenceId="CK_NOTIFICATION_SUBSCRIPTION_CONTACT_ID" indexType="btree">
            <column name="contact_id"/>
        </index>
        <index referenceId="CK_NOTIFICATION_SUBSCRIPTION_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>
