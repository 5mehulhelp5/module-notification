<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="commercekings_notification_cooldown_cleanup" instance="CommerceKings\Notification\Cron\CleanUpCooldown" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="commercekings_notification_subscription_cleanup" instance="CommerceKings\Notification\Cron\CleanUpSubscriptions" method="execute">
            <schedule>10 3 * * *</schedule>
        </job>
        <job name="commercekings_notification_delivery_state_cleanup" instance="CommerceKings\Notification\Cron\CleanUpDeliveryState" method="execute">
            <schedule>12 3 * * *</schedule>
        </job>
        <job name="commercekings_notification_contact_cleanup" instance="CommerceKings\Notification\Cron\CleanUpContacts" method="execute">
            <schedule>15 3 * * *</schedule>
        </job>
        <job name="commercekings_notification_stop_cleanup" instance="CommerceKings\Notification\Cron\CleanUpStops" method="execute">
            <schedule>20 3 * * *</schedule>
        </job>
        <job name="commercekings_notification_address_consent_cleanup" instance="CommerceKings\Notification\Cron\CleanUpAddressConsents" method="execute">
            <schedule>25 3 * * *</schedule>
        </job>
    </group>
</config>
