<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="CommerceKings\Notification\Api\SenderInterface" type="CommerceKings\Notification\Model\Sender"/>
    <preference for="CommerceKings\Notification\Api\ProviderPoolInterface" type="CommerceKings\Notification\Model\ProviderPool"/>
    <preference for="CommerceKings\Notification\Api\CooldownInterface" type="CommerceKings\Notification\Model\Cooldown"/>
    <preference for="CommerceKings\Notification\Api\QueueInterface" type="CommerceKings\Notification\Model\Queue"/>
    <preference for="CommerceKings\Notification\Api\ContactRepositoryInterface" type="CommerceKings\Notification\Model\ContactRepository"/>
    <preference for="CommerceKings\Notification\Api\SubscriptionManagementInterface" type="CommerceKings\Notification\Model\SubscriptionManagement"/>
    <preference for="CommerceKings\Notification\Api\SubscriptionRepositoryInterface" type="CommerceKings\Notification\Model\SubscriptionRepository"/>
    <preference for="CommerceKings\Notification\Api\SubscriptionGuardInterface" type="CommerceKings\Notification\Model\SubscriptionGuard"/>
    <preference for="CommerceKings\Notification\Api\SubscriptionRemovalInterface" type="CommerceKings\Notification\Model\SubscriptionRemoval"/>
    <!-- who may subscribe: everyone (opt-out) unless a permission module replaces it, e.g. the consent bridge -->
    <preference for="CommerceKings\Notification\Api\SubscriptionPermissionInterface" type="CommerceKings\Notification\Model\OpenPermission"/>
    <!-- the subscriber behind it: not recognizable, no unsubscribe link - replaced together with the permission -->
    <preference for="CommerceKings\Notification\Api\SubscriberInterface" type="CommerceKings\Notification\Model\AnonymousSubscriber"/>
    <!-- a feature's notice where shoppers subscribe: Automatic follows the permission's isOptOut() -->
    <preference for="CommerceKings\Notification\Api\OptOutNoticeInterface" type="CommerceKings\Notification\Model\OptOutNotice"/>
    <!-- modules that point to contacts register a ContactReferenceInterface here, so unused contacts can be removed -->
    <type name="CommerceKings\Notification\Model\ContactReferencePool">
        <arguments>
            <argument name="references" xsi:type="array">
                <item name="subscriptions" xsi:type="object">CommerceKings\Notification\Model\SubscriptionContactReference</item>
            </argument>
        </arguments>
    </type>
    <!-- feature modules register who may subscribe here (argument "types": code => SubscriptionTypeInterface),
         (with commercekings/module-consent-notification, withdrawing the purpose's consent removes the subscriptions) -->
    <type name="CommerceKings\Notification\Model\SubscriptionTypePool">
        <arguments>
            <argument name="types" xsi:type="array"/>
        </arguments>
    </type>
    <virtualType name="CommerceKingsNotificationEmailLength" type="Magento\Framework\Validator\StringLength">
        <arguments>
            <argument name="options" xsi:type="array">
                <item name="max" xsi:type="number">255</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="CommerceKings\Notification\Model\SubscriptionManagement">
        <arguments>
            <argument name="emailLengthValidator" xsi:type="object">CommerceKingsNotificationEmailLength</argument>
        </arguments>
    </type>
    <!-- delivery providers (argument "providers": code => ProviderInterface); the admin selects one per channel.
         A provider module adds its item here and its settings group in its own system.xml. -->
    <type name="CommerceKings\Notification\Model\ProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="magento_email" xsi:type="object">CommerceKings\Notification\Model\Provider\MagentoEmail</item>
            </argument>
        </arguments>
    </type>
    <!-- feature modules register their notification types here (argument "types": code => NotificationTypeInterface) -->
    <type name="CommerceKings\Notification\Model\TypePool">
        <arguments>
            <argument name="types" xsi:type="array"/>
        </arguments>
    </type>
</config>
