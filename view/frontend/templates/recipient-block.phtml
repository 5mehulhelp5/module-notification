<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
use CommerceKings\Notification\Controller\Block\Index;

$state = (string)$block->getData('state');
$form = static function (string $action, string $label) use ($block, $escaper): string {
    return '<form id="cknotification-block-form" action="' . $escaper->escapeUrl($block->getUrl('cknotification/block'))
        . '" method="post">' . $block->getBlockHtml('formkey')
        . '<input type="hidden" name="r" value="' . $escaper->escapeHtmlAttr($block->getData('link_recipient')) . '"/>'
        . '<input type="hidden" name="s" value="' . $escaper->escapeHtmlAttr($block->getData('link_signature')) . '"/>'
        . '<input type="hidden" name="do" value="' . $escaper->escapeHtmlAttr($action) . '"/>'
        . '<button class="action primary" type="submit"><span>' . $escaper->escapeHtml($label) . '</span></button></form>';
};
?>
<div class="ck-recipient-block" style="max-width: 560px; margin: 20px auto 40px; text-align: center;">
    <?php if ($state === Index::STATE_INVALID): ?>
    <p><?= $escaper->escapeHtml(__('This link is not valid, so nothing has changed.')) ?></p>
    <?php elseif ($state === Index::STATE_CONFIRM): ?>
    <p><?= $escaper->escapeHtml(__('Stop reminders and other marketing emails to this address?')) ?></p>
    <p><?= $escaper->escapeHtml(__('Emails about your orders still arrive.')) ?></p>
    <?= /* @noEscape */ $form('block', (string)__('Stop these emails')) ?>
    <?php elseif ($state === Index::STATE_BLOCKED): ?>
    <p><?= $escaper->escapeHtml(__('Done. We will not send reminders or other marketing emails to this address.')) ?></p>
    <?php if ($block->getData('can_undo')): ?>
    <p><?= $escaper->escapeHtml(__('Changed your mind?')) ?></p>
    <?= /* @noEscape */ $form('undo', (string)__('Turn reminders back on')) ?>
    <?php endif; ?>
    <?php else: ?>
    <p><?= $escaper->escapeHtml(__('Done. You can sign up for reminders again; earlier sign-ups were removed when you stopped the emails.')) ?></p>
    <?php endif; ?>
    <a class="action primary" href="<?= $escaper->escapeUrl($block->getUrl('')) ?>"><?= $escaper->escapeHtml(__('Back to the store')) ?></a>
</div>
